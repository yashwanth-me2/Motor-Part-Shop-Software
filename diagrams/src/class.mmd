  }
  class Sale {
    +int sale_id
    +String part_no
    +int quantity
    +float amount
    +Date sale_date
    +record_sale() void
  }
  class ReportGenerator {
    +daily_revenue(date) float
    +order_list(date) List
    +monthly_sales(month) List
  }
  Vendor "1" --> "*" Part : supplies
  Part "1" --> "*" Sale : sold in
