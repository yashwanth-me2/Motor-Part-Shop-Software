classDiagram
  direction LR
  class Vendor {
    +int vendor_id
    +String name
    +String address
    +String phone
  }
  class Part {
    +String part_no
    +String name
    +String manufacturer
    +String vehicle_make
    +String vehicle_model
    +String rack_no
    +float price
    +int stock
    +int vendor_id
